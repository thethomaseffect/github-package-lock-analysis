{
  "name": "github-package-lock-analysis",
  "version": "0.1.0",
  "description": "GitHub Action that diffs package-lock.json changes and reports nested dependency security updates",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "ncc build dist/index.js -o dist/bundle --minify --license licenses.txt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fixtures": "tsx scripts/run-fixtures.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vercel/ncc": "^0.38.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
